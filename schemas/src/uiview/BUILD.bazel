load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@rules_vite//vite:defs.bzl", "vitest_test")
load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")

package(default_visibility = ["//visibility:public"])

vitest_test(
    name = "action_normalization_test",
    srcs = ["action_normalization.test.ts"],
    deps = [":seam", "//schemas:node_modules/@bufbuild/protobuf", "//schemas:node_modules/@savvifi/meridian-proto-ts", "//schemas:node_modules/vitest"],
)

vitest_test(
    name = "affordance_predicate_test",
    srcs = ["affordance_predicate.test.ts"],
    deps = [":seam", "//schemas:node_modules/@bufbuild/protobuf", "//schemas:node_modules/@savvifi/meridian-proto-ts", "//schemas:node_modules/vitest"],
)

vitest_test(
    name = "affordance_presentation_test",
    srcs = ["affordance_presentation.test.ts"],
    deps = [":seam", "//schemas:node_modules/@bufbuild/protobuf", "//schemas:node_modules/@savvifi/meridian-proto-ts", "//schemas:node_modules/vitest"],
)

vitest_test(
    name = "conversation_sequence_test",
    srcs = ["conversation_sequence.test.ts"],
    deps = [":seam", "//schemas:node_modules/vitest"],
)

vitest_test(
    name = "conversation_tone_test",
    srcs = ["conversation_tone.test.ts"],
    deps = [":seam", "//schemas:tone_conformance_data", "//schemas:node_modules/@bufbuild/protobuf", "//schemas:node_modules/@savvifi/meridian-proto-ts", "//schemas:node_modules/vitest"],
)

js_run_binary(
    name = "core_runtime",
    tool = "//schemas:embed_core_wasm",
    srcs = ["//schemas:core_glue.js", "//schemas:core_bytes.wasm", "//schemas:core_glue.d.ts"],
    args = [
        "$(execpath //schemas:core_glue.js)",
        "$(execpath //schemas:core_bytes.wasm)",
        "$(execpath //schemas:core_glue.d.ts)",
        "$(RULEDIR)/generated/meridian_uiview.js",
        "$(RULEDIR)/generated/meridian_uiview.d.ts",
    ],
    outs = ["generated/meridian_uiview.js", "generated/meridian_uiview.d.ts"],
)

js_library(
    name = "core_runtime_library",
    srcs = [":core_runtime"],
)

vitest_test(
    name = "prompt_response_test",
    srcs = ["prompt_response.test.ts"],
    deps = [
        ":seam",
        "//schemas:node_modules/@bufbuild/protobuf",
        "//schemas:node_modules/@savvifi/meridian-proto-ts",
        "//schemas:node_modules/vitest",
    ],
)

# @savvifi/meridian-schemas/uiview — the framework-neutral WebRenderer seam. Pure
# interfaces over the canonical @savvifi/meridian-proto-ts PanelDescriptor + Theme; no
# renderer or React. Formatting delegates to the pinned embedded Rust core.
# meridian-web AND meridian-web-react implement it,
# so both depend on this module rather than on each other. Emits .js + .d.ts
# alongside the sources (out_dir "."). Packaged as @savvifi/meridian-schemas in
# //:BUILD.bazel (so the package paths stay rooted at src/uiview/).
ts_project(
    name = "seam",
    srcs = [
        "admission.ts",
        "action_normalization.ts",
        "affordance_presentation.ts",
        "affordance_predicate.ts",
        "core_runtime.ts",
        "conversation_tone.ts",
        "conversation_sequence.ts",
        "index.ts",
        "navigation.ts",
        "masked_multiline.ts",
        "media.ts",
        "prompt_response.ts",
        "prompt_template.ts",
        "form_values.ts",
        "stat.ts",
        "transport.ts",
        "value_display.ts",
        "web_renderer.ts",
    ],
    declaration = True,
    out_dir = ".",
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [
        ":core_runtime_library",
        "//schemas:node_modules/@bufbuild/protobuf",
        "//schemas:node_modules/@savvifi/meridian-proto-ts",
    ],
)
