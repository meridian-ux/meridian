// Type-check the seam's own unit tests without emitting into the source tree.
//
// The published package is `src/uiview/**/*.js` (schemas.package.json "files"),
// so a compiled test emitted next to its source would ship to npm. tsconfig.json
// therefore excludes *.test.ts and this config picks them back up for a
// no-emit CI typecheck; Vitest runs the source tests directly for coverage.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"]
  },
  // Scoped to the files under test and what they import — NOT `**/*.ts`.
  //
  // Protocol response tests also use the canonical generated types. CI's
  // workspace prepare/codegen supplies these for pnpm, and their separate
  // Bazel target checks the same tests against the hermetic producer.
  "include": [
    "admission.ts",
    "admission.test.ts",
    "action_normalization.ts",
    "action_normalization.test.ts",
    "invocation.test.ts",
    "affordance_predicate.test.ts",
    "navigation.ts",
    "navigation.test.ts",
    "prompt_response.ts",
    "prompt_response.test.ts",
    "form_values.ts"
  ],
  "exclude": []
}
