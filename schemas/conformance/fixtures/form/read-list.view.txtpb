id: "form-read-list"
title: "form-read-list"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "form-read-list"
    title: "list"
    form {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        repeated {
          scalar {
            label: "Item"
            text {
              default_value: "one"
            }
          }
          min_items: 2
          max_items: 4
        }
        display {
          type: VALUE_TYPE_LIST
        }
      }
      mode: FORM_MODE_READONLY
      submit_affordance {
        label: "Save"
        rpc {
          service: "fixture.Inputs"
          method: "Submit"
        }
      }
    }
  }
}
