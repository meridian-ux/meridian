id: "form-input-date-time"
title: "form-input-date-time"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "form-input-date-time"
    title: "date-time"
    form {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        text {
          default_value: "2026-03-29T13:45:00Z"
        }
        display {
          type: VALUE_TYPE_DATE_TIME
        }
      }
      mode: FORM_MODE_EDIT
      submit_affordance {
        label: "Save"
        rpc {
          service: "fixture.Inputs"
          method: "Submit"
        }
      }
    }
  }
}
