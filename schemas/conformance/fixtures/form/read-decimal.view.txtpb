id: "form-read-decimal"
title: "form-read-decimal"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "form-read-decimal"
    title: "decimal"
    form {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        number {
          min: -100.0
          max: 100.0
          default_value: 12.5
        }
        display {
          type: VALUE_TYPE_DECIMAL
          number {
            fraction_digits: 2
          }
        }
      }
      mode: FORM_MODE_READONLY
      submit_affordance {
        label: "Save"
        rpc {
          service: "fixture.Inputs"
          method: "Submit"
        }
      }
    }
  }
}
