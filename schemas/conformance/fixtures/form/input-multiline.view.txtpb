id: "form-input-multiline"
title: "form-input-multiline"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "form-input-multiline"
    title: "multiline"
    form {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        text {
          default_value: "first\nsecond"
        }
        display {
          type: VALUE_TYPE_MULTILINE_TEXT
        }
      }
      mode: FORM_MODE_EDIT
      submit_affordance {
        rpc {
          service: "fixture.Inputs"
          method: "Submit"
        }
      }
    }
  }
}
