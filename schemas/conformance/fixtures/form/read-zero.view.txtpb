id: "form-read-zero"
title: "form-read-zero"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "form-read-zero"
    title: "zero"
    form {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        integer {
          min: -100
          max: 100
        }
        display {
          type: VALUE_TYPE_INTEGER
        }
      }
      mode: FORM_MODE_READONLY
      submit_affordance {
        label: "Save"
        rpc {
          service: "fixture.Inputs"
          method: "Submit"
        }
      }
    }
  }
}
