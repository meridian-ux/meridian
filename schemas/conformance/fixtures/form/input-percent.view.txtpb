id: "form-input-percent"
title: "form-input-percent"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "form-input-percent"
    title: "percent"
    form {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        number {
          min: -100.0
          max: 100.0
          default_value: 0.125
        }
        display {
          type: VALUE_TYPE_PERCENT
          number {
            fraction_digits: 3
          }
        }
      }
      mode: FORM_MODE_EDIT
      submit {
        service: "fixture.Inputs"
        method: "Submit"
      }
    }
  }
}
