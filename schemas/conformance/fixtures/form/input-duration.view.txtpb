id: "form-input-duration"
title: "form-input-duration"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "form-input-duration"
    title: "duration"
    form {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        text {
          default_value: "4 min 12 s"
        }
        display {
          type: VALUE_TYPE_DURATION
        }
      }
      mode: FORM_MODE_EDIT
      submit {
        service: "fixture.Inputs"
        method: "Submit"
      }
    }
  }
}
