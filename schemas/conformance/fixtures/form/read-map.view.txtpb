id: "form-read-map"
title: "form-read-map"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "form-read-map"
    title: "map"
    form {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        display {
          type: VALUE_TYPE_JSON
        }
        key_value_map {
        }
      }
      mode: FORM_MODE_READONLY
      submit_affordance {
        rpc {
          service: "fixture.Inputs"
          method: "Submit"
        }
      }
    }
  }
}
