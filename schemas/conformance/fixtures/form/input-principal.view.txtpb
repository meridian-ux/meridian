id: "form-input-principal"
title: "form-input-principal"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "form-input-principal"
    title: "principal"
    form {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        text {
          default_value: "Ada <ada@example.com>"
        }
        display {
          type: VALUE_TYPE_PRINCIPAL
        }
      }
      mode: FORM_MODE_EDIT
      submit_affordance {
        rpc {
          service: "fixture.Inputs"
          method: "Submit"
        }
      }
    }
  }
}
