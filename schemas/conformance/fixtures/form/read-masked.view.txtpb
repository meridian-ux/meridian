id: "form-read-masked"
title: "form-read-masked"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "form-read-masked"
    title: "masked"
    form {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        masked {
          default_value: "fixture-secret"
        }
        display {
          type: VALUE_TYPE_TEXT
        }
      }
      mode: FORM_MODE_READONLY
      submit {
        service: "fixture.Inputs"
        method: "Submit"
      }
    }
  }
}
