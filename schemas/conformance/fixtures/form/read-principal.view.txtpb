id: "form-read-principal"
title: "form-read-principal"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "form-read-principal"
    title: "principal"
    form {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        text {
          default_value: "Ada <ada@example.com>"
        }
        display {
          type: VALUE_TYPE_PRINCIPAL
        }
      }
      mode: FORM_MODE_READONLY
      submit {
        service: "fixture.Inputs"
        method: "Submit"
      }
    }
  }
}
