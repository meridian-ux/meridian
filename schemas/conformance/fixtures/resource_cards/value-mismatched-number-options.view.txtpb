id: "resource_cards-value-mismatched-number-options"
title: "value-mismatched-number-options"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "resource_cards-value-mismatched-number-options"
    title: "mismatched-number-options"
    resource_cards {
      populate {
        service: "fixture.Values"
        method: "List"
      }
      rows_field: "rows"
      template {
        title_field: "value"
        subtitle_field: "value"
        status_field: "value"
        meta {
          label: "Declared value"
          field_path: "value"
          display {
            type: VALUE_TYPE_PRINCIPAL
            number {
              fraction_digits: 2
            }
          }
        }
        title_display {
          type: VALUE_TYPE_PRINCIPAL
          number {
            fraction_digits: 2
          }
        }
        subtitle_display {
          type: VALUE_TYPE_PRINCIPAL
          number {
            fraction_digits: 2
          }
        }
        status_display {
          type: VALUE_TYPE_PRINCIPAL
          number {
            fraction_digits: 2
          }
        }
      }
    }
  }
}
