id: "resource_cards-value-multiline"
title: "value-multiline"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "resource_cards-value-multiline"
    title: "multiline"
    resource_cards {
      populate {
        service: "fixture.Values"
        method: "List"
      }
      rows_field: "rows"
      template {
        title_field: "value"
        subtitle_field: "value"
        status_field: "value"
        meta {
          label: "Declared value"
          field_path: "value"
          display {
            type: VALUE_TYPE_MULTILINE_TEXT
          }
        }
        title_display {
          type: VALUE_TYPE_MULTILINE_TEXT
        }
        subtitle_display {
          type: VALUE_TYPE_MULTILINE_TEXT
        }
        status_display {
          type: VALUE_TYPE_MULTILINE_TEXT
        }
      }
    }
  }
}
