id: "llm_prompt-input-percent"
title: "llm_prompt-input-percent"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "llm_prompt-input-percent"
    title: "percent"
    llm_prompt {
      user_template: "Value={{value}}"
      slots {
        name: "value"
        field {
          field_id: "value"
          label: "Declared input"
          request_field: "value"
          number {
            min: -100.0
            max: 100.0
            default_value: 0.125
          }
          display {
            type: VALUE_TYPE_PERCENT
            number {
              fraction_digits: 3
            }
          }
        }
      }
    }
  }
}
