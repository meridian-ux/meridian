id: "llm_prompt-input-date-time"
title: "llm_prompt-input-date-time"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "llm_prompt-input-date-time"
    title: "date-time"
    llm_prompt {
      user_template: "Value={{value}}"
      slots {
        name: "value"
        field {
          field_id: "value"
          label: "Declared input"
          request_field: "value"
          text {
            default_value: "2026-03-29T13:45:00Z"
          }
          display {
            type: VALUE_TYPE_DATE_TIME
          }
        }
      }
    }
  }
}
