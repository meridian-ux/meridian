id: "llm_prompt-input-map"
title: "llm_prompt-input-map"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "llm_prompt-input-map"
    title: "map"
    llm_prompt {
      user_template: "Value={{value}}"
      slots {
        name: "value"
        field {
          field_id: "value"
          label: "Declared input"
          request_field: "value"
          display {
            type: VALUE_TYPE_JSON
          }
          key_value_map {
          }
        }
      }
    }
  }
}
