id: "llm_prompt-input-invalid-date"
title: "llm_prompt-input-invalid-date"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "llm_prompt-input-invalid-date"
    title: "invalid-date"
    llm_prompt {
      user_template: "Value={{value}}"
      slots {
        name: "value"
        field {
          field_id: "value"
          label: "Declared input"
          request_field: "value"
          text {
            default_value: "not-a-date"
          }
          display {
            type: VALUE_TYPE_DATE
          }
        }
      }
    }
  }
}
