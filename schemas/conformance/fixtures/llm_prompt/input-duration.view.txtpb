id: "llm_prompt-input-duration"
title: "llm_prompt-input-duration"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "llm_prompt-input-duration"
    title: "duration"
    llm_prompt {
      user_template: "Value={{value}}"
      slots {
        name: "value"
        field {
          field_id: "value"
          label: "Declared input"
          request_field: "value"
          text {
            default_value: "4 min 12 s"
          }
          display {
            type: VALUE_TYPE_DURATION
          }
        }
      }
    }
  }
}
