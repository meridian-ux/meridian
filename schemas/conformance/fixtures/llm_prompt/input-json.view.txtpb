id: "llm_prompt-input-json"
title: "llm_prompt-input-json"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "llm_prompt-input-json"
    title: "json"
    llm_prompt {
      user_template: "Value={{value}}"
      slots {
        name: "value"
        field {
          field_id: "value"
          label: "Declared input"
          request_field: "value"
          nested {
            fields {
              field_id: "ready"
              label: "Ready"
              boolean {
                default_value: true
              }
            }
          }
          display {
            type: VALUE_TYPE_JSON
          }
        }
      }
    }
  }
}
