id: "llm_prompt-input-unknown"
title: "llm_prompt-input-unknown"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "llm_prompt-input-unknown"
    title: "unknown"
    llm_prompt {
      user_template: "Value={{value}}"
      slots {
        name: "value"
        field {
          field_id: "value"
          label: "Declared input"
          request_field: "value"
          text {
            default_value: "literal"
          }
          display {
            type: 999
          }
        }
      }
    }
  }
}
