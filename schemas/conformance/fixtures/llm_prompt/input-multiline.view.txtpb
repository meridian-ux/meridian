id: "llm_prompt-input-multiline"
title: "llm_prompt-input-multiline"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "llm_prompt-input-multiline"
    title: "multiline"
    llm_prompt {
      user_template: "Value={{value}}"
      slots {
        name: "value"
        field {
          field_id: "value"
          label: "Declared input"
          request_field: "value"
          text {
            default_value: "first\nsecond"
          }
          display {
            type: VALUE_TYPE_MULTILINE_TEXT
          }
        }
        multi_line: true
      }
    }
  }
}
