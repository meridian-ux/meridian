id: "llm_prompt-input-enum"
title: "llm_prompt-input-enum"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "llm_prompt-input-enum"
    title: "enum"
    llm_prompt {
      user_template: "Value={{value}}"
      slots {
        name: "value"
        field {
          field_id: "value"
          label: "Declared input"
          request_field: "value"
          enum_selection {
            allowed_values: "READY"
            allowed_values: "DONE"
            default_value: "READY"
          }
          display {
            type: VALUE_TYPE_ENUM
          }
        }
      }
    }
  }
}
