        status_field: "value"
        title_display {
          type: VALUE_TYPE_DECIMAL
          number {
            fraction_digits: 101
          }
        }
        subtitle_display {
          type: VALUE_TYPE_DECIMAL
          number {
            fraction_digits: 101
          }
        }
        status_display {
          type: VALUE_TYPE_DECIMAL
          number {
            fraction_digits: 101
          }
        }
      }
    }
  }
}
