id: "gallery-empty"
title: "Conformance: gallery · empty"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "gallery-empty"
    title: "gallery · empty"
    gallery {
      populate {
        service: "demo.Gallery"
        method: "List"
      }
      rows_field: "items"
      placeholder: "no assets"
      card {
        title_field: "name"
        subtitle_field: "description"
        status_field: "status"
        href_field: "href"
        action_label_field: "action"
      }
    }
  }
}
