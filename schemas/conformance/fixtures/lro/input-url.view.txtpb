id: "lro-input-url"
title: "lro-input-url"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "lro-input-url"
    title: "url"
    lro {
      start {
        service: "fixture.Inputs"
        method: "Start"
      }
      metadata_type: "fixture.Metadata"
      response_type: "fixture.Response"
      inputs {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        text {
          default_value: "https://example.com/a?b=1"
        }
        display {
          type: VALUE_TYPE_URL
        }
      }
    }
  }
}
