id: "lro-input-integer"
title: "lro-input-integer"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "lro-input-integer"
    title: "integer"
    lro {
      start {
        service: "fixture.Inputs"
        method: "Start"
      }
      metadata_type: "fixture.Metadata"
      response_type: "fixture.Response"
      inputs {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        integer {
          min: -100
          max: 100
          default_value: -42
        }
        display {
          type: VALUE_TYPE_INTEGER
        }
      }
    }
  }
}
