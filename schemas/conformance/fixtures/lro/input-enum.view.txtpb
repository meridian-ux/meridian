id: "lro-input-enum"
title: "lro-input-enum"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "lro-input-enum"
    title: "enum"
    lro {
      start {
        service: "fixture.Inputs"
        method: "Start"
      }
      metadata_type: "fixture.Metadata"
      response_type: "fixture.Response"
      inputs {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        enum_selection {
          allowed_values: "READY"
          allowed_values: "DONE"
          default_value: "READY"
        }
        display {
          type: VALUE_TYPE_ENUM
        }
      }
    }
  }
}
