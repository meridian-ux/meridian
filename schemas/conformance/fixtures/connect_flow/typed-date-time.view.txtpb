id: "connect_flow-typed-date-time"
title: "typed-date-time"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "connect_flow-typed-date-time"
    title: "date-time"
    connect_flow {
      targets {
        id: "fixture"
        label: "Fixture target"
      }
      default_target_id: "fixture"
      endpoint {
        value: "2026-03-29T13:45:00Z"
        label: "Typed value"
        display {
          type: VALUE_TYPE_DATE_TIME
        }
      }
    }
  }
}
