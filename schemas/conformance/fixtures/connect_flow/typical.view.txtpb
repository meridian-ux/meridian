id: "connect_flow-typical"
title: "Conformance: connect_flow · typical"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "connect_flow-typical"
    title: "connect_flow · typical"
    connect_flow {
      prompt: "Every agent points at the same endpoint."
      targets {
        id: "cursor"
        label: "Cursor"
        name: "Cursor"
        description: "One click installs it."
        actions {
          id: "add"
          label: "Add to Cursor"
          uri: "cursor://install"
          emphasis: EMPHASIS_PRIMARY
        }
        configs {
          content: "{ \"mcpServers\": { \"demo\": { \"url\": \"https://mcp.example/mcp\" } } }"
          language: "json"
          path: "~/.cursor/mcp.json"
        }
      }
      targets {
        id: "codex"
        label: "Codex"
        name: "Codex CLI"
        description: "Bridge the remote endpoint with mcp-remote."
        configs {
          content: "[mcp_servers.demo]\ncommand = \"npx\"\nargs = [\"-y\", \"mcp-remote\", \"https://mcp.example/mcp\"]"
          language: "toml"
          path: "~/.codex/config.toml"
        }
      }
      default_target_id: "cursor"
      endpoint {
        value: "mcp.example.com/mcp"
        label: "Endpoint"
      }
    }
  }
}
