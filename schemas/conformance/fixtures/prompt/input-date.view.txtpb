id: "prompt-input-date"
title: "prompt-input-date"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "prompt-input-date"
    title: "date"
    prompt {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        text {
          default_value: "2026-03-29"
        }
        display {
          type: VALUE_TYPE_DATE
        }
      }
      accept_label: "Submit"
    }
  }
}
