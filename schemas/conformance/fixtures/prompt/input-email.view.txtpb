id: "prompt-input-email"
title: "prompt-input-email"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "prompt-input-email"
    title: "email"
    prompt {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        text {
          default_value: "Ada <ada@example.com>"
        }
        display {
          type: VALUE_TYPE_EMAIL
        }
      }
      accept_label: "Submit"
    }
  }
}
