id: "prompt-input-decimal"
title: "prompt-input-decimal"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "prompt-input-decimal"
    title: "decimal"
    prompt {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        number {
          min: -100.0
          max: 100.0
          default_value: 12.5
        }
        display {
          type: VALUE_TYPE_DECIMAL
          number {
            fraction_digits: 2
          }
        }
      }
      accept_label: "Submit"
    }
  }
}
