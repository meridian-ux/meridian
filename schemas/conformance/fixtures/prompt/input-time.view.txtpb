id: "prompt-input-time"
title: "prompt-input-time"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "prompt-input-time"
    title: "time"
    prompt {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        text {
          default_value: "13:45:00"
        }
        display {
          type: VALUE_TYPE_TIME
        }
      }
      accept_label: "Submit"
    }
  }
}
