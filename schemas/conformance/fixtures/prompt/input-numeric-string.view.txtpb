id: "prompt-input-numeric-string"
title: "prompt-input-numeric-string"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "prompt-input-numeric-string"
    title: "numeric-string"
    prompt {
      fields {
        field_id: "value"
        label: "Declared input"
        request_field: "value"
        text {
          default_value: "0012.50"
        }
        display {
          type: VALUE_TYPE_DECIMAL
          number {
            fraction_digits: 2
          }
        }
      }
      accept_label: "Submit"
    }
  }
}
