id: "detail_header-value-decimal"
title: "value-decimal"
layout {
  stacked {
  }
}
slots {
  id: "content"
  panel {
    panel_id: "detail_header-value-decimal"
    title: "decimal"
    detail_header {
      title: "Fixture record"
      descriptor_rows {
        label: "Declared value"
        source_path: "value"
        display {
          type: VALUE_TYPE_DECIMAL
          number {
            fraction_digits: 2
          }
        }
      }
      populate {
        service: "fixture.Values"
        method: "List"
      }
    }
  }
}
