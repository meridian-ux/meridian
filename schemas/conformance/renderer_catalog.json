{
  "$schema-note": "The renderer catalog includes public tiers and explicitly tracked development consumers. Panel renderers are cross-checked against conformance/coverage.json; local entrypoints are checked against this repository. External tiers and consumers must carry an explicit external source.",
  "statuses": {
    "stable": "Supported renderer tier.",
    "preview": "Publicly advertised but still in preview.",
    "development": "Tracked implementation work that is not yet a public tier."
  },
  "modalities": {
    "panel": {
      "schema": "schemas/proto/interaction.proto",
      "coverage": "schemas/conformance/coverage.json"
    },
    "conversation": {
      "schema": "schemas/proto/conversation.proto",
      "oneof": "Block.kind",
      "coverage": "schemas/conformance/coverage.json"
    },
    "launchpad": {
      "schema": "schemas/proto/interaction.proto",
      "oneof": "Command.action",
      "coverage": "schemas/conformance/coverage.json"
    }
  },
  "renderers": [
    {
      "id": "web-components",
      "modality": "panel",
      "status": "stable",
      "source": { "kind": "local", "root": "packages/web", "entrypoint": "src/uiview/renderer.ts" }
    },
    {
      "id": "web-react",
      "modality": "panel",
      "status": "stable",
      "source": { "kind": "local", "root": "packages/web-react", "entrypoint": "src/panel_renderer.tsx" }
    },
    {
      "id": "mui-kit",
      "modality": "panel",
      "status": "stable",
      "source": { "kind": "local", "root": "packages/mui-kit", "entrypoint": "src/mui_kit.tsx" }
    },
    {
      "id": "html-kit",
      "modality": "panel",
      "status": "stable",
      "source": { "kind": "local", "root": "packages/web-react", "entrypoint": "src/html_kit.tsx" }
    },
    {
      "id": "shadcn-kit",
      "modality": "panel",
      "status": "stable",
      "source": { "kind": "local", "root": "packages/web-react", "entrypoint": "src/shadcn_kit.tsx" }
    },
    {
      "id": "tui",
      "modality": "panel",
      "status": "stable",
      "source": { "kind": "local", "root": "crates/tui", "entrypoint": "rust/tui/src/widget.rs" }
    },
    {
      "id": "swiftui",
      "modality": "panel",
      "status": "preview",
      "source": {
        "kind": "local",
        "root": "packages/swiftui",
        "entrypoint": "Sources/MeridianUI/MeridianPanel.swift"
      }
    },
    {
      "id": "chat-html",
      "modality": "conversation",
      "status": "stable",
      "source": { "kind": "local", "root": "packages/chat", "entrypoint": "src/render_html.ts" }
    },
    {
      "id": "chat-react",
      "modality": "conversation",
      "status": "stable",
      "source": { "kind": "local", "root": "packages/chat", "entrypoint": "src/render_react.tsx" }
    },
    {
      "id": "playground",
      "modality": "conversation",
      "status": "development",
      "source": {
        "kind": "external",
        "repo": "meridian-internal",
        "note": "Private development consumer at apps/playground/src/App.tsx. Uses the pinned published Conversation renderer and a host canvas delegate, not a new public renderer package. The internal playground CI gate validates all nine canonical Block fixtures through the real local chat-host HTTP/SSE path and production Chromium."
      }
    },
    {
      "id": "launchpad",
      "modality": "launchpad",
      "status": "stable",
      "source": { "kind": "local", "root": "packages/launchpad", "entrypoint": "src/index.ts" }
    }
  ]
}
