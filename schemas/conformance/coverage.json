  "$schema-note": "Coverage of meridian.ui.v1.PanelDescriptor's `body` oneof, per renderer. Checked against proto/panel.proto by tools/check_coverage.mjs: the arm set must match exactly, every non-'renders' cell must carry a reason, and a full-parity arm that is missing or structurally unrenderable must carry a waiver. Adding an arm to the proto without declaring its coverage fails.",
  "statuses": {
    "renders": "The renderer draws the shape.",
    "placeholder": "The renderer draws an explanatory placeholder instead of the shape.",
    "separate-entrypoint": "Drawn, but by a dedicated entrypoint outside the main dispatch.",
    "missing": "Not implemented.",
    "structural-gap": "Cannot be implemented without an API change \u2014 no seam exists.",
    "not-applicable": "This tier does not own the shape."
  },
  "parity": {
    "full": "panel.proto: every modality realizes it at full fidelity.",
    "specialized": "panel.proto: cannot meet the parity bar; documents a degradation ladder.",
