{
  "name": "@savvifi/meridian-schemas",
  "version": "0.25.0",
  "type": "module",
  "description": "The framework- and brand-neutral root of the meridian design language: the WebRenderer seam (mount/update/unmount + transport contracts) over the canonical meridian.ui.v1 PanelDescriptor + meridian.theme.v1 Theme. Renderers implement the seam; emitters produce descriptors.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meridian-ux/meridian.git",
    "directory": "schemas"
  },
  "exports": {
    ".": {
      "types": "./src/uiview/index.d.ts",
      "import": "./src/uiview/index.js"
    },
    "./uiview": {
      "types": "./src/uiview/index.d.ts",
      "import": "./src/uiview/index.js"
    }
  },
  "files": [
    "src/uiview/**/*.js",
    "src/uiview/**/*.d.ts"
  ],
  "scripts": {
    "test": "vitest run src/uiview/admission.test.ts src/uiview/navigation.test.ts"
  },
  "dependencies": {
    "@savvifi/meridian-proto-ts": "workspace:*",
    "@bufbuild/protobuf": "2.12.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.4",
    "vitest": "2.1.4"
  }
}
