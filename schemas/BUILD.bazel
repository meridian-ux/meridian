load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@meridian_npm//:defs.bzl", "npm_link_all_packages")

package(default_visibility = ["//visibility:public"])

js_library(
    name = "value_option_data",
    srcs = ["conformance/value_option_cases.ts", "conformance/core.json"],
    deps = [":node_modules/@bufbuild/protobuf", ":node_modules/@savvifi/meridian-proto-ts"],
)

exports_files([
    "conformance/constrained_value_types.json",
    "conformance/value_types.json",
    "conformance/core.json",
])

js_library(
    name = "tone_conformance_data",
    srcs = ["conformance/tone_cases.ts"],
    deps = [":node_modules/@savvifi/meridian-proto-ts"],
)

js_library(
    name = "conversation_value_data",
    srcs = ["conformance/conversation_values.ts", "conformance/constrained_value_types.json", "conformance/core.json"],
    deps = [
        ":node_modules/@bufbuild/protobuf",
        ":node_modules/@savvifi/meridian-proto-ts",
    ],
)

# rules_js copies runtime data through a producer in the owning package.
# Native tests also use exports_files above for compile-time include_str!.
js_library(
    name = "core_conformance_data",
    srcs = [
        "conformance/core.json",
        "conformance/value_types.json",
    ],
)

# schemas is a pnpm workspace package with its own dependencies, so it needs its
# own node_modules tree — //:node_modules can only hold the ROOT package.json's
# four toolchain packages. Every other workspace package already had this; this
# one lost it when the npm_link_package calls moved to //:BUILD.bazel, which was
# a mistake on my part rather than a consequence of the merge.
npm_link_all_packages(name = "node_modules")

# One pinned Rust producer, also consumed by the local development preparer.
genrule(
    name = "core_bindings",
    srcs = ["//crates/core/rust/uiview:uiview_wasm"],
    outs = ["core_glue.js", "core_glue.d.ts", "core_bytes.wasm"],
    cmd = """
for f in $(SRCS); do
  case $$f in
    *meridian_uiview.js) cp $$f $(location core_glue.js) ;;
    *meridian_uiview.d.ts) cp $$f $(location core_glue.d.ts) ;;
    *meridian_uiview_bg.wasm) cp $$f $(location core_bytes.wasm) ;;
  esac
done
""",
)

js_binary(
    name = "embed_core_wasm",
    entry_point = "tools/embed_core_wasm.mjs",
)

js_binary(
    name = "proto_facades",
    entry_point = "tools/proto_facades.mjs",
    data = [":node_modules/@bufbuild/protobuf"],
)

alias(
    name = "core_runtime",
    actual = "//schemas/src/uiview:core_runtime",
)

# Renderer conformance consumes the same protobuf fixture messages from every
# modality. This is test infrastructure, not a published schemas entrypoint.
js_library(
    name = "computed_accessibility_data",
    srcs = ["conformance/normalize_ax.cjs"] + glob([
        "conformance/fixtures/**/*.binpb",
        "conformance/ax/**/*.txt",
    ], allow_empty = True),
)

js_library(
    name = "conformance_fixtures",
    srcs = [
        "conformance/fixtures.ts",
        "conformance/normalize_dom.ts",
        "conformance/populated.ts",
        "conformance/prompt.ts",
        "conformance/state_cases.ts",
        "conformance/layout_cases.ts",
        "conformance/value_types.json",
        "conformance/constrained_value_types.json",
        "conformance/input_values.binpb",
        "conformance/coverage.json",
    ] + glob(["conformance/binpb/*.binpb", "conformance/fixtures/**/*.binpb", "conformance/fixtures/**/*.txtpb", "conformance/layout/*.binpb"]),
    deps = [
        "//schemas:node_modules/@bufbuild/protobuf",
        "//schemas:node_modules/@savvifi/meridian-proto-ts",
    ],
)

# Protobuf wire fixtures emitted from conformance/fixtures.ts. Native renderers
# consume these exact bytes; they are test data, not a published package entry.
filegroup(
    name = "conformance_binpb",
    srcs = glob(["conformance/binpb/*.binpb"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "stateful_conformance_data",
    srcs = ["conformance/core.json", "conformance/value_types.json", "conformance/constrained_value_types.json", "conformance/input_values.binpb", "conformance/coverage.json"] + glob([
        "conformance/fixtures/**/*.binpb",
        "conformance/native/**/*.txt",
        "conformance/layout/*.binpb",
    ], allow_empty = True),  # The test rejects missing goldens; permits first recording.
    visibility = ["//visibility:public"],
)

js_library(
    name = "layout_conformance_data",
    srcs = glob(["conformance/layout/*.binpb"]),
)

# The npm_link_package calls that used to live here moved to //:BUILD.bazel.
# They create `node_modules/<pkg>` in the package that DECLARES them, and this
# directory was the workspace root before the merge — so leaving them here linked
# into schemas/node_modules while every consumer resolves against //:node_modules.

# Assemble @savvifi/meridian-schemas: its GENERATED published manifest
# (schemas.package.json — written by tools/publish_manifests.py, because the
# development package.json carries `workspace:*`, which npm publish cannot resolve
# from the detached copy the release job publishes from) + the compiled seam under
# src/uiview/. Defined in THIS package rather than at the root so npm_package's
# default root_paths preserve the src/uiview/ layout the "./uiview" export points
# at.
npm_package(
    name = "schemas_pkg",
    srcs = [
        "schemas.package.json",
        "//schemas/src/uiview:core_runtime",
        "//schemas/src/uiview:seam",
        "//schemas/src/theme:theme",
    ],
    package = "@savvifi/meridian-schemas",
    replace_prefixes = {"schemas.package.json": "package.json"},
    visibility = ["//visibility:public"],
)

# `pkg` is a CONVENTION, not a preference. rules_js keeps one package store at
# the workspace root, and //:BUILD.bazel's npm_link_all_packages resolves every
# first-party `workspace:*` member to `//<package-dir>:pkg`. This directory is a
# member, so without this the store entry
# `//:.aspect_rules_js/node_modules/@savvifi+meridian-schemas@0.0.0` fails
# analysis with "no such target '//schemas:pkg'".
#
# An alias rather than a rename: `schemas_pkg` is named by publish.yml and reads
# better at a distance than a bare `:pkg`.
alias(
    name = "pkg",
    actual = ":schemas_pkg",
    visibility = ["//visibility:public"],
)

exports_files([
    "package.json",
    "tsconfig.json",
    "tools/conformance_snapshots.mjs",
    "compat/pre-v1.binpb",
])
