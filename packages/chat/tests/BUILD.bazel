load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@rules_vite//vite:defs.bzl", "vitest_test")

package(default_visibility = ["//visibility:public"])

# Compile a consumer against the emitted public declarations, not private types.
ts_project(
    name = "api_contract_types",
    srcs = ["api_contract_types.ts"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = {"compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM"],
        "strict": True,
        "skipLibCheck": True,
        "declaration": True,
        "types": [],
    }},
    deps = [
        "//packages/chat:chat",
        "//packages/chat:node_modules/@types/react",
        "//packages/chat:node_modules/react",
    ],
)

# The tests + their dev-only @rules_vite load live here (NOT in the root package)
# so a bazel_dep consumer of @meridian_chat//:browser_bundle (botnoc) can evaluate
# the root package without seeing rules_vite. Test files import the compiled
# surface via ../src/*.js (the //:chat_lib outputs).

# The renderer-neutral streaming model: dedup by seq, upsert blocks by blockId,
# status. Fed real toJson(ConversationEventSchema) frames (proto conformance).
vitest_test(
    name = "model",
    srcs = [
        "model.test.ts",
        "fixtures.ts",
    ],
    deps = [
        "//packages/chat:chat_lib",
        "//packages/chat:node_modules/@bufbuild/protobuf",
        "//packages/chat:node_modules/@savvifi/meridian-proto-ts",
        "//packages/chat:node_modules/vitest",
    ],
)

# The renderers: renderBlockInner (HTML string) + <Conversation> (react-dom/server).
vitest_test(
    name = "render",
    srcs = [
        "render.test.tsx",
        "view_static.test.tsx",
        "modality_conformance.test.tsx",
        "api_contract.test.tsx",
        "value_corpus.test.tsx",
        "tone.test.tsx",
        "sequence.test.tsx",
        "lifecycle.test.tsx",
        "fixtures.ts",
    ],
    deps = [
        "//schemas:conversation_value_data",
        "//schemas:conformance_fixtures",
        "//packages/chat:node_modules/jsdom",
        "//packages/chat:node_modules/react",
        "//packages/chat:node_modules/react-dom",
        "//packages/chat:chat_lib",
        "//packages/chat:api_manifests",
        "//packages/chat:node_modules/@bufbuild/protobuf",
        "//packages/chat:node_modules/@savvifi/meridian-proto-ts",
        "//packages/chat:node_modules/vitest",
    ],
)
