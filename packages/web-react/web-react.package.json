{
  "name": "@savvifi/meridian-web-react",
  "version": "1.0.0",
  "meridian": {
    "rendererIds": [
      "web-react",
      "html-kit",
      "shadcn-kit"
    ]
  },
  "type": "module",
  "description": "React adapter for the meridian WebRenderer seam: a kit-agnostic core (MeridianProvider, PanelRenderer, ComponentKit, reactWebRenderer) that renders meridian.ui.v1 PanelDescriptors through a swappable ComponentKit (MUI, shadcn, \u2026). The premium web renderer tier of the meridian renderer family.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meridian-ux/meridian.git",
    "directory": "packages/web-react"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@savvifi/meridian-proto-ts": "1.0.0",
    "@savvifi/meridian-schemas": "1.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
