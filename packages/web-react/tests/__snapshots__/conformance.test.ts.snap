exports[`Swap B — shadcnKit renders the same fixtures, different look > shadcnKit renders the steps shape and shows its title > shadcn-kit/steps 1`] = `
"h3
  "Create a sponsor"
section aria-label="Steps"
  p
    "Add an employer and confirm a colleague can see it."
  ol
    li
      "1."
      "Open the Sponsors page"
      "Admin"
      p
        "The list of every employer your organization administers."
      img alt="The sponsors list" src="/evidence/sponsors.png"
    li
      "2."
      "Add a new sponsor"
      "Admin"
      p
        "Name it, then set Status to Active and Kind to Customer."
    li
      "3."
      "Confirm a colleague sees it"
      "Manager"
      p
        "Everyone in your organization shares one sponsor list."
  p
    "The sponsor is now visible to your whole team.""
`;

