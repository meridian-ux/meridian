exports[`Swap B — shadcnKit renders the same fixtures, different look > shadcnKit renders the connectFlow shape and shows its title > shadcn-kit/connect_flow 1`] = `
"h3
  "Connect your agent"
p
  "Every agent points at the same endpoint."
"Endpoint"
button type="button"
  code
    "mcp.example.com/mcp"
div role="tablist"
  button role="tab" aria-selected="true" type="button"
    "Cursor"
  button role="tab" aria-selected="false" type="button"
    "Codex"
h3
  "Cursor"
p
  "One click installs it."
a href="cursor://install"
  "Add to Cursor"
figure
  figcaption
    "~/.cursor/mcp.json"
    "(json)"
  button type="button"
    "Copy"
  pre
    code
      "{ \\"mcpServers\\": { \\"demo\\": { \\"url\\": \\"https://mcp.example/mcp\\" } } }""
`;

