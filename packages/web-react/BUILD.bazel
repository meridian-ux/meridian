load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@meridian_npm//:defs.bzl", "npm_link_all_packages")
load("@rules_vite//vite:defs.bzl", "vitest_test")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

# @savvifi/meridian-web-react — the React renderer tier (kit-agnostic) over the
# WebRenderer seam. Compiles the .tsx adapter + the html reference kit. Resolves
# the seam from @savvifi/meridian-schemas/uiview and the canonical types from
# @savvifi/meridian-proto-ts (both first-party links in //:BUILD.bazel); react is its own.
ts_project(
    name = "web_react",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.tsx",
    ]),
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/react",
        ":node_modules/react-dom",
        "//packages/web-react:node_modules/@bufbuild/protobuf",
        "//packages/web-react:node_modules/@savvifi/meridian-schemas",
        "//packages/web-react:node_modules/@savvifi/meridian-proto-ts",
    ],
)

# The compiled renderer surface, as a js_library the test can import via
# ../src/*.js (mirrors //tests:src_lib).
js_library(
    name = "web_react_lib",
    srcs = [":web_react"],
)

# The publishable @savvifi/meridian-web-react npm package: package.json at the
# root + the compiled src/*.{js,d.ts}. Published to npmjs (see the OIDC workflow
# in .github/workflows/publish.yml).
npm_package(
    name = "pkg",
    srcs = [
        # NOT the development package.json — that one carries `workspace:*`, which
        # `npm publish` cannot resolve from the detached $RUNNER_TEMP copy the
        # release job publishes from. This is the generated manifest with real
        # versions (tools/publish_manifests.py), mapped onto package.json below.
        "web-react.package.json",
        ":web_react",
    ],
    replace_prefixes = {"web-react.package.json": "package.json"},
    package = "@savvifi/meridian-web-react",
    visibility = ["//visibility:public"],
)

# Runtime test: renders a PanelDescriptor through htmlKit via react-dom/server.
vitest_test(
    name = "test",
    srcs = ["tests/panel_renderer.test.ts"],
    deps = [
        ":node_modules/react",
        ":node_modules/react-dom",
        ":web_react_lib",
        "//packages/web-react:node_modules/@bufbuild/protobuf",
        "//packages/web-react:node_modules/@savvifi/meridian-proto-ts",
        "//packages/web-react:node_modules/vitest",
    ],
)

# Cross-shape conformance over the canonical fixtures (the crank gate seed): every
# meridian.ui.v1 shape renders, htmlKit covers what it claims, adhoc routes.
vitest_test(
    name = "conformance",
    srcs = [
        "tests/conformance.test.ts",
        "tests/fixtures.ts",
    ],
    deps = [
        ":node_modules/react",
        ":node_modules/react-dom",
        ":web_react_lib",
        "//packages/web-react:node_modules/@bufbuild/protobuf",
        "//packages/web-react:node_modules/@savvifi/meridian-proto-ts",
        "//packages/web-react:node_modules/vitest",
    ],
)

# Pagination wiring: the pure request/response field mapping the usePagedRows hook
# glues together (CLIENT / OFFSET / CURSOR), driven by TablePanel.pagination.
vitest_test(
    name = "pagination",
    srcs = ["tests/pagination.test.ts"],
    deps = [
        ":node_modules/react",
        ":node_modules/react-dom",
        ":web_react_lib",
        "//packages/web-react:node_modules/@bufbuild/protobuf",
        "//packages/web-react:node_modules/@savvifi/meridian-proto-ts",
        "//packages/web-react:node_modules/vitest",
    ],
)

# ViewRenderer round-trip over the two real studio views (products list + detail):
# the composition/layout tier renders through the kits (ViewDescriptor -> slots ->
# panels + FormPanel + actions).
vitest_test(
    name = "view",
    srcs = ["tests/view.test.ts"],
    deps = [
        ":node_modules/react",
        ":node_modules/react-dom",
        ":web_react_lib",
        "//packages/web-react:node_modules/@bufbuild/protobuf",
        "//packages/web-react:node_modules/@savvifi/meridian-proto-ts",
        "//packages/web-react:node_modules/@savvifi/meridian-schemas",
        "//packages/web-react:node_modules/vitest",
    ],
)
