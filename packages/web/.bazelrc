common --enable_bzlmod

# meridian_uiview_core declares its crate_universe extension with isolate = True
# (to namespace its `crates` against a consumer's). Isolated extension usages are
# still behind an experimental flag, and the requirement is INHERITED: this repo
# uses no isolation of its own, but every bazel command here dies at MODULE parse
# resolving that dep — "in module dependency chain <root> -> meridian_uiview_core
# @0.6.0 … parameter 'isolate' is experimental". It was missing, which is why
# nothing here has been buildable. meridian-chat already carries this line for its
# own npm extension, with the same explanation.
common --experimental_isolated_extension_usages

# rules_vite lives in the tbzl registry; everything else from BCR.
common --registry=https://registry.tbzl.dev/
common --registry=https://bcr.bazel.build/

build --announce_rc
build --keep_going
test --test_output=errors
