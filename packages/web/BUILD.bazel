load("@meridian_npm//:defs.bzl", "npm_link_all_packages")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")

package(default_visibility = ["//visibility:public"])

# Links the npm deps (@savvifi/meridian-proto-ts + @savvifi/meridian-schemas +
# @bufbuild/protobuf, from the pnpm lockfile) into the workspace node_modules so
# //src:core resolves them. The web-components toolkit is consumed by hosts as
# the Bazel target //src:core (botnoc links it); it is not linked first-party here.
npm_link_all_packages(name = "node_modules")

# Preparation only: the existing release workflow does not publish this target.
# Generated manifest pins first-party dependencies to the module version.
npm_package(
    name = "pkg",
    srcs = [
        "README.md",
        "web.package.json",
        "//packages/web/src:core",
        "//packages/web/src:worker_command_schema",
        "//packages/web/theme:compiled",
        "//packages/web/theme:css",
    ],
    replace_prefixes = {"web.package.json": "package.json"},
    package = "@savvifi/meridian-web",
)

exports_files([
    "package.json",
    "tsconfig.json",
])
