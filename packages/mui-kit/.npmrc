# @aion/* is published to the private GitLab package registry (project 144).
# Auth (or anonymous read) is inherited from the user/CI ~/.npmrc. All other
# scopes — incl. @savvifi/meridian-* — resolve from the default registry (npmjs).
@aion:registry=https://gitlab.savvifi.com/api/v4/projects/144/packages/npm/
