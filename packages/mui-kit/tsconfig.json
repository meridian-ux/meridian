{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@meridian-ux/proto-ts": ["./node_modules/@meridian-ux/proto-ts"],
      "@meridian-ux/proto-ts/*": ["./node_modules/@meridian-ux/proto-ts/*"]
    }
  },
  "include": ["src", "tests", "harness"]
}
