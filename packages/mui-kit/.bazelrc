common --enable_bzlmod

# ─── Module registries ────────────────────────────────────────────────────────
# Declared HERE rather than inherited from a developer's ~/.bazelrc. rules_chrome
# and rules_tectonic live in the tbzl registry, and relying on a global config to
# find them made this repo unbuildable on any machine that did not happen to have
# the right registry list — which is exactly what happened after the workspace reorg
# moved the registry path a global rc still pointed at. Every other meridian
# repo declares its own registries; this one had not.
#
# registry.fastverk.com is RETIRED. It was listed second here and served nothing
# this repo needs: MODULE.bazel.lock records it resolving 208 modules, every one
# of which tbzl.dev also serves, while rules_chrome / rules_tectonic /
# rules_github resolve from tbzl.dev alone. Removing it is a strict no-op on the
# resolved graph.
common --registry=https://registry.tbzl.dev/
common --registry=https://bcr.bazel.build/

build --announce_rc
build --keep_going
test --test_output=errors
