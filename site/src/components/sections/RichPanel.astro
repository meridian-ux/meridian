---
// A meridian-style panel mockup (reuses the real .meridian-uiview-* contract).
const { panel } = Astro.props;
const CLS = { OK: "v-safe", WARN: "v-warn", FAIL: "v-block", INFO: "v-info", PENDING: "v-run", NA: "v-na" };
---
<div class="panel-shell" style="margin-top:28px">
  <div class="panel-bar">
    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
    {panel.title && <span class="title">{panel.title}</span>}
    {panel.badge && <span class="live"><i></i> {panel.badge}</span>}
  </div>
  <div class="panel-body">
    {panel.meta && <div class="meridian-uiview-meta">{panel.meta}</div>}
    <div class="tscroll">
      <table class="meridian-uiview-table">
        {panel.columns?.length > 0 && (
          <thead><tr>{panel.columns.map((c) => <th>{c}</th>)}</tr></thead>
        )}
        <tbody>
          {(panel.rows || []).map((r) => (
            <tr>
              {(r.cells || []).map((c) => (
                <td>
                  {c.status ? (
                    <span class={`verdict ${CLS[c.status] || "v-info"}`}>{c.text}</span>
                  ) : c.mono ? (
                    <span style="font-family:var(--mono)">{c.text}</span>
                  ) : (
                    c.text
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {panel.footer?.length > 0 && (
      <div class="panel-foot">
        {panel.footer.map((f) => (
          <span>{f.label}: <span class="k">{f.value}</span></span>
        ))}
      </div>
    )}
  </div>
</div>
