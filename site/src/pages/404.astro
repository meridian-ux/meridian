---
import Base from "../layouts/Base.astro";
---
<Base title="Not found — tomato-bazel" description="That page doesn't exist.">
  <section class="close" style="border-top:0; padding-top:clamp(80px,14vw,180px)">
    <span class="eyebrow" style="justify-content:center; display:flex">error · 404</span>
    <h2 style="margin-top:16px">This page didn't pass the merge gate.</h2>
    <p>The link is broken or the page moved. Let's get you back to something proven.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/">Back home</a>
      <a class="btn btn-ghost" href="/features">Browse features →</a>
    </div>
  </section>
</Base>
