load("@npm//:defs.bzl", "npm_link_all_packages")

# @npm//site:… , not @npm//: — astro is a dependency of THIS workspace package,
# and @npm//: carries only the root package.json's four toolchain packages. The
# label was correct while site/ was its own repository root. Same class as the
# ten //:node_modules/X deps repointed in 6349ac9, but a load() rather than a
# dep, which is why that sweep did not see it — and a bad load() fails the whole
# package, so it read as "site is broken" rather than "one label moved".
load("@npm//site:astro/package_json.bzl", astro_bin = "bin")
load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@rules_astro//astro:defs.bzl", "astro_dev", "astro_site")

package(default_visibility = ["//visibility:public"])

exports_files([
    "package.json",
    ".npmrc",
])

npm_link_all_packages(name = "node_modules")

# The astro CLI as a hermetic js_binary tool.
astro_bin.astro_binary(name = "astro_tool")

# bazel build //:build  ->  bazel-bin/build/ (the static dist tree)
astro_site(
    name = "build",
    srcs = glob(
        ["src/**", "public/**"],
        exclude = ["**/.DS_Store"],
    ) + [
        "package.json",
        "tsconfig.json",
    ],
    astro_bin = ":astro_tool",
    # @astrojs/telemetry writes a config file under $HOME on first run. The RBE
    # workers set HOME=/nonexistent, so `astro build` dies with
    # `EACCES: permission denied, mkdir '/nonexistent/.config/astro'` -- remotely
    # only; a local darwin build has a writable HOME and passes. Telemetry is
    # also a network call, which a hermetic action has no business making.
    env = {"ASTRO_TELEMETRY_DISABLED": "1"},
    node_modules = ":node_modules",
)

# bazel run //:dev  ->  local Astro dev server
astro_dev(
    name = "dev",
    srcs = glob(["src/**", "public/**"]) + ["package.json", "tsconfig.json"],
    astro_bin = ":astro_tool",
    node_modules = ":node_modules",
)

# bazel test //:smoke_test  ->  assert the built site publishes every route the
# feature catalog implies, and that its internal links resolve.
#
# Load-bearing mechanically as much as substantively: the build runner sends
# TEST_TARGETS=//... and `bazel test` exits 4 ("no test targets were found, yet
# testing was requested") on a repo with none.
#
# js_test, not sh_test: sh_test pulls in @bazel_tools//tools/cpp:current_cc_toolchain
# and the CI image sets BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1, so an sh_test analyses
# fine on darwin and fails on linux with "Unable to find a CC toolchain". Node is
# already this repo's toolchain, through a module dep we already have.
js_test(
    name = "smoke_test",
    data = [
        ":build",
        "astro.config.mjs",
        "src/content/features.json",
    ],
    entry_point = "tools/smoke_test.mjs",
)
