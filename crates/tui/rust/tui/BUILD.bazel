load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "tui",
    srcs = [
        "src/content.rs",
        "src/conversation.rs",
        "src/invoker.rs",
        "src/launchpad.rs",
        "src/lib.rs",
        "src/llm_prompt.rs",
        "src/prompt.rs",
        "src/state.rs",
        "src/theme.rs",
        "src/widget.rs",
    ],
    crate_name = "meridian_tui",
    edition = "2021",
    # theme.rs re-exports the `theme_proto` rust_prost_library types directly
    # (the single, Bazel-native codegen path — no cargo/prost-build fallback).
    deps = [
        # The shared rust core, now in-repo: the native `uiview` lib
        # (PanelDescriptor types via the `proto` module, render/scoring helpers,
        # RequestBuilder) + the `theme_proto` prost crate.
        "//crates/core/rust/uiview",
        "//crates/core/rust/uiview:theme_proto",
        # serde_json::Value crosses the uiview API boundary (RpcInvoker /
        # render_table / RenderedRow). The alias exists because cross-MODULE
        # @crates copies are distinct types even at the same version, so both
        # sides had to name one instance. Inside one module that hazard is gone,
        # but the alias is kept: it is still the single declaration point, and
        # removing it would be a change with nothing to gain.
        "//crates/core/rust:serde_json",
        "@crates//:crossterm",
        "@crates//:prost",
        "@crates//:ratatui",
        "@crates//:regex",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "tui_test",
    crate = ":tui",
    edition = "2021",
)

# The executable. src/main.rs has been on disk since the Cargo workspace merge
# and was in NO Bazel target — //:Cargo.toml declares
# `[[bin]] name = "meridian-tui"` and the Bazel side never gained the counterpart,
# so `bazel run` could not do what `cargo run` could.
#
# This is the first runnable thing in the estate. Before the merge it could not
# exist: the crate depended on meridian_uiview and theme_proto, which only Bazel
# produced, so cargo could not build it — and Bazel had no binary rule, so nothing
# could run it either.
rust_binary(
    name = "meridian_tui",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = [
        ":tui",
        "//crates/core/rust/uiview",
        "//crates/core/rust:serde_json",
        "@crates//:crossterm",
        "@crates//:prost",
        "@crates//:ratatui",
    ],
)

# tests/render_descriptor.rs drives the same render path main.rs does, through
# ratatui's TestBackend so it needs no TTY. rust_test(crate = …) compiles UNIT
# tests only, so an integration test needs its own target or it never runs.
rust_test(
    name = "render_descriptor_test",
    srcs = ["tests/render_descriptor.rs"],
    edition = "2021",
    deps = [
        ":tui",
        "//crates/core/rust/uiview",
        "//crates/core/rust:serde_json",
        "@crates//:prost",
        "@crates//:ratatui",
    ],
)
